# Copy to `server/.env` for local dev. Do NOT commit real secrets.

# Server
PORT=3000
# production | development
NODE_ENV=development

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio (SMS & Video calls - Future Integration)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# OpenAI (AI assistant features - Future Integration)
OPENAI_API_KEY=

# CORS
# Comma-separated list of allowed frontend origins in production, e.g.
# CORS_ALLOWED_ORIGINS=https://vendoscity1.vercel.app,https://www.vendoscity.com
CORS_ALLOWED_ORIGINS=

# Upload limits
# UPLOAD_MAX_IMAGE_MB=6

# Local Postgres (optional)
# If you use the local DB mode (no Supabase keys configured), set DATABASE_URL here.
# Example:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/vendoscity

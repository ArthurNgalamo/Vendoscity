# Copy to `server/.env` for local dev. Do NOT commit real secrets.

# Server
PORT=3000
# production | development
NODE_ENV=development

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio (SMS & Video calls - Future Integration)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# OpenAI (AI assistant features - Future Integration)
OPENAI_API_KEY=

# CORS
# Comma-separated list of allowed frontend origins in production, e.g.
# CORS_ALLOWED_ORIGINS=https://vendoscity1.vercel.app,https://www.vendoscity.com
CORS_ALLOWED_ORIGINS=

# Upload limits
# UPLOAD_MAX_IMAGE_MB=6

# Local Postgres (optional)
# If you use the local DB mode (no Supabase keys configured), set DATABASE_URL here.
# Example:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/vendoscity

# SMS Gateway Webhook Security
# A secure token shared with the mobile SMS listener app to avoid spoofing in production
SMS_GATEWAY_API_KEY=dev_momo_secret_token

# ============================================================
# IMPORTATION DE PRODUITS (Alibaba / AliExpress / 1688)
# ============================================================

# Clé API RapidAPI utilisée pour les scrapers de produits
# https://rapidapi.com (hub d'API tierces pour AliExpress, Alibaba, 1688)
RAPIDAPI_KEY=

# Hôte du scraper AliExpress sur RapidAPI
RAPIDAPI_ALIEXPRESS_HOST=aliexpress-datahub.p.rapidapi.com

# Hôte du scraper Alibaba/1688 sur RapidAPI
RAPIDAPI_ALIBABA_HOST=alibaba-datahub.p.rapidapi.com

# ============================================================
# TAUX DE CHANGE (Conversion vers FCFA)
# ============================================================

# Taux fixe de conversion USD vers FCFA
# (À mettre à jour manuellement ou via un cron job de taux de change)
# Valeur de référence BCEAO : 1 USD ≈ 600 FCFA
USD_TO_FCFA=610

# Taux de conversion CNY (Yuan) vers FCFA
# 1688 facture en Yuan Chinois (CNY), pas en USD
# Valeur de référence : 1 CNY ≈ 84 FCFA
CNY_TO_FCFA=84

# ============================================================
# TRADUCTION AUTOMATIQUE (1688 est en Chinois Simplifié)
# ============================================================

# Option 1 (Recommandée - Gratuite jusqu'à 500k caractères/mois) : LibreTranslate auto-hébergé ou API publique
# https://libretranslate.com
LIBRETRANSLATE_API_URL=https://libretranslate.com/translate
LIBRETRANSLATE_API_KEY=

# Option 2 (Premium) : DeepL API pour traduction de haute qualité zh->fr
# https://www.deepl.com/fr/pro-api
# Gratuit jusqu'à 500 000 caractères/mois
DEEPL_API_KEY=

# ============================================================
# RÉSEAUX SOCIAUX (Auto-publication vendeurs vérifiés)
# ============================================================

# Facebook / Instagram (Meta Graph API)
META_APP_ID=
META_APP_SECRET=

# TikTok for Developers
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ============================================================
# CACHE & CONTRÔLE DES COÛTS API
# ============================================================

# Connexion Redis distribuée optionnelle (ex: rediss://default:password@host:port)
# Si vide ou non trouvé, le cache bascule sur la table PostgreSQL temporary_cache
REDIS_URL=

# Consommation mensuelle maximale autorisée en crédits (AliExpress/Alibaba search/details)
# Par défaut 10000 crédits
API_MONTHLY_LIMIT=10000

# Seuil d'alerte budgétaire en pourcentage (déclenche une alerte dans la console et la table api_alerts)
# Par défaut 90%
API_ALERT_PERCENT=90

